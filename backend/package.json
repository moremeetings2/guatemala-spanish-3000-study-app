{
  "name": "spanish3000-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Workers + D1 backend for the Guatemala Spanish 3000 study app: accounts, progress sync, and admin word management.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build:seed": "node scripts/build_seed.mjs",
    "db:migrate:local": "wrangler d1 execute spanish3000 --local --file=migrations/0001_init.sql",
    "db:migrate": "wrangler d1 execute spanish3000 --remote --file=migrations/0001_init.sql",
    "db:seed:local": "wrangler d1 execute spanish3000 --local --file=seed.sql",
    "db:seed": "wrangler d1 execute spanish3000 --remote --file=seed.sql"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "wrangler": "^3.99.0"
  }
}
